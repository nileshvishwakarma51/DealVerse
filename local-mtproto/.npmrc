# GramJS pulls in bufferutil / utf-8-validate, which try to compile a native addon
# via node-gyp (needs Python + a C toolchain). They're performance-only — ws/GramJS
# fall back to pure JS without them — so we skip ALL install build scripts. This lets
# `npm install` / `npm ci` succeed on minimal hosts (Termux, slim containers) with no
# build tools. No dependency here needs a build script to function.
ignore-scripts=true
