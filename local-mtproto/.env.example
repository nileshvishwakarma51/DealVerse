# Copy this file to ".env" and fill in your values. NEVER commit the real .env.

# ── DealVerse admin (REQUIRED) ──────────────────────────────────────────────
# The listener logs in with these to read your listener list, reuse your Telegram
# login, and push messages.
DEALVERSE_BASE_URL=https://f54vu9h2ra.execute-api.ap-south-1.amazonaws.com/prod
DEALVERSE_NAME=poras
DEALVERSE_PASSWORD=1234

# ── Your Telegram USER account (OPTIONAL) ───────────────────────────────────
# EASIEST: leave these blank — the listener reuses the account you already logged
# into via the DealVerse "Telegram login" tab (fetched securely at startup).
# Only fill these if you want the listener to use its OWN separate login:
#   api_id + api_hash from https://my.telegram.org → "API development tools",
#   TG_PHONE = an account that is a MEMBER of the source channels.
TG_API_ID=
TG_API_HASH=
TG_PHONE=
# Or paste a StringSession directly to skip the phone login entirely:
TG_SESSION=

# ── Optional: sources ───────────────────────────────────────────────────────
# SOURCES: comma-separated @usernames / t.me links to watch INSTEAD of the admin
#   panel listeners (override). Leave EMPTY to use the admin-panel listeners.
SOURCES=
# EXTRA_SOURCES: channels watched ONLY by this local listener, ADDED on top of
#   whatever SOURCES resolves to. Your logged-in account must be a MEMBER of them.
EXTRA_SOURCES=
